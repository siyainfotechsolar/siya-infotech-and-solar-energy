{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/windows/flutter/ephemeral": true,
    "**/.plugin_symlinks": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/windows/flutter/ephemeral": true,
    "**/.plugin_symlinks": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/windows/flutter/ephemeral/**": true,
    "**/.plugin_symlinks/**": true,
    "**/build/**": true
  },
  "java.import.gradle.enabled": true,
  "java.import.gradle.annotationProcessing.enabled": false
}
